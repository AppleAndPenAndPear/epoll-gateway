{
    "port": 5005,
    "backlog": 1024,
    "num_workers": 2,
    "www_root": "./www",
    "thread_pool": {"min": 2, "max": 10, "scale_up": 2, "scale_down": 1},
    "cache_max_entries": 1024,
    "cache_max_file_size_mb": 1,
    "keepalive_timeout": 5,
    "tls": {
        "cert_path": "certs/server.crt",
        "key_path": "certs/server.key"
    },
    "admin": {
        "enabled": true,
        "port": 8105,
        "bind": "127.0.0.1",
        "api_keys": ["admin-demo-key"]
    },
    "rate_limit": {
        "capacity": 20,
        "refill_per_second": 10
    },
    "upstreams": {
        "demo-service": {
            "servers": [
                {"host": "127.0.0.1", "port": 8091},
                {"host": "127.0.0.1", "port": 8092}
            ],
            "algorithm": "round_robin"
        },
        "user-service": {
            "servers": [
                {"host": "127.0.0.1", "port": 8093}
            ],
            "algorithm": "round_robin"
        },
        "orders-service": {
            "servers": [
                {"host": "127.0.0.1", "port": 8094}
            ],
            "algorithm": "round_robin"
        },
        "recommendations-service": {
            "servers": [
                {"host": "127.0.0.1", "port": 8095}
            ],
            "algorithm": "round_robin"
        }
    },
    "routes": [
        {
            "name": "demo-api",
            "method": "GET",
            "path": "/demo/*",
            "auth_required": false,
            "upstream_target": {
                "name": "demo-service",
                "timeout_ms": 5000
            }
        },
        {
            "name": "profile-page",
            "method": "GET",
            "path": "/profile",
            "auth_required": false,
            "target_type": "composite",
            "composite_target": {
                "name": "profile-page",
                "dependencies": [
                    {
                        "name": "user",
                        "upstream_name": "user-service",
                        "path": "/me",
                        "method": "GET",
                        "required": true,
                        "timeout_ms": 2000
                    },
                    {
                        "name": "orders",
                        "upstream_name": "orders-service",
                        "path": "/orders/42",
                        "method": "GET",
                        "required": false,
                        "timeout_ms": 2000
                    },
                    {
                        "name": "recommendations",
                        "upstream_name": "recommendations-service",
                        "path": "/recommendations/42",
                        "method": "GET",
                        "required": true,
                        "timeout_ms": 2000
                    }
                ]
            }
        }
    ],
    "api_keys": [
        {"key": "test-key-123", "name": "Test Client"}
    ]
}
