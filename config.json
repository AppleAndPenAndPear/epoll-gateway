{
    "port": 5005,
    "backlog": 1024,
    "num_workers": 2,
    "www_root": "./www",
    "thread_pool": {
        "min": 2,
        "max": 10,
        "scale_up": 2,
        "scale_down": 1
    },
    "cache_max_entries": 1024,
    "cache_max_file_size_mb": 1,
    "keepalive_timeout": 5,
    "tls": {
        "cert_path": "certs/server.crt",
        "key_path": "certs/server.key"
    },
    "admin": {
        "enabled": true,
        "port": 8105,
        "bind": "127.0.0.1",
        "api_keys": ["admin-demo-key"]
    },
    "rate_limit": {
        "capacity": 20,
        "refill_per_second": 10
    },
    "api_keys": [
        {"key": "test-key-123", "name": "Test Client", "rate_limit": {"capacity": 10, "refill_per_second": 3}},
        {"key": "premium-key-456", "name": "Premium Client", "rate_limit": {"capacity": 1000, "refill_per_second": 100}}
    ],
    "routes": []
}
