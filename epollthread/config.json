{
    "port": 5005,
    "backlog": 1024,
    "num_workers": 2,
    "www_root": "./www",
    "thread_pool": {
        "min": 2,
        "max": 10,
        "scale_up": 2,
        "scale_down": 1
    },
    "cache_max_entries": 1024,
    "cache_max_file_size_mb": 1,
    "keepalive_timeout": 5,
    "upstreams": {
        "test-service": {
            "servers": [
                {"host": "127.0.0.1", "port": 8081},
                {"host": "127.0.0.1", "port": 8082}
            ],
            "algorithm": "round_robin"
        }
    },
    "routes": [
        {
            "method": "GET",
            "path": "/api/test/*",
            "upstream": "test-service"
        }
    ],
    "rate_limit": {
        "capacity": 5,
        "refill_per_second": 1
    },
    "api_keys": [
        {"key": "test-key-123", "name": "测试客户端", "rate_limit": {"capacity": 10, "refill_per_second": 3}},
        {"key": "premium-key-456", "name": "高级客户端", "rate_limit": {"capacity": 1000, "refill_per_second": 100}}
    ]
}