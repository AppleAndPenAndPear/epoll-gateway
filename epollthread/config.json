{
    "port": 5005,
    "backlog": 1024,
    "num_workers": 2,
    "www_root": "./www",
    "thread_pool": {
        "min": 2,
        "max": 10,
        "scale_up": 2,
        "scale_down": 1
    },
    "cache_max_entries": 1024,
    "cache_max_file_size_mb": 1,
    "keepalive_timeout": 5,
    "upstreams": {
        "test-service": {
            "servers": [
                {"host": "127.0.0.1", "port": 8081}
            ]
        }
    },
    "routes": [
        {
            "method": "GET",
            "path": "/api/test/*",
            "upstream": "test-service"
        }
    ]
}