# systemd unit for the epoll gateway.
#
# Install:
#   sudo cp build/server /usr/local/bin/epoll-gateway
#   sudo useradd -r -s /usr/sbin/nologin epoll-gateway        # matches User/Group below
#   sudo mkdir -p /var/lib/epoll-gateway/logs                 # logs/ must exist:
#                                                             # spdlog does not create it
#   sudo cp config.json api_keys.json /var/lib/epoll-gateway/ # config + secrets
#   sudo cp -r certs /var/lib/epoll-gateway/certs             # TLS material
#   sudo chown -R epoll-gateway:epoll-gateway /var/lib/epoll-gateway
#   sudo cp deploy/gateway.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now epoll-gateway
#
# The paths above must match WorkingDirectory below: the binary loads
# config.json and writes logs/epollserver.log relative to that directory.
#
# Reload (hot, without dropping connections):
#   systemctl reload epoll-gateway        # sends SIGHUP
#   curl -s -X POST -H "X-API-Key: ..." http://127.0.0.1:8105/admin/reload
#
# Stop/restart use graceful shutdown: the gateway stops accepting, drains
# in-flight requests for shutdown_drain_timeout seconds, then exits.

[Unit]
Description=epoll API gateway
Documentation=https://github.com/AppleAndPenAndPear/epoll-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=epoll-gateway
Group=epoll-gateway
# WorkingDirectory holds config.json, api_keys.json, certs/ and logs/
WorkingDirectory=/var/lib/epoll-gateway
ExecStart=/usr/local/bin/epoll-gateway
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# systemd's default soft limit (1024) is below what the gateway needs: one fd
# per accepted connection plus cached static files and pooled upstream
# connections, all held while the accept backlog itself is 1024 deep. Hitting
# the limit surfaces as EMFILE on accept.
LimitNOFILE=65535

# Secrets can be provided outside config.json (env > file > inline)
#Environment=GW_API_KEYS=[{"key":"...","name":"prod"}]

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/epoll-gateway

# Graceful shutdown: stop accepting, then drain in-flight requests.
# Must be larger than shutdown_drain_timeout in config.json (default 30s),
# otherwise systemd kills the process before draining finishes.
KillSignal=SIGTERM
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
